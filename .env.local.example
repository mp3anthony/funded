# Copy this file to .env.local and fill in your own values.
# NEVER commit real credentials. Do not prefix server-only secrets with NEXT_PUBLIC_.

# ── Supabase (client, safe to expose) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Web push (VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# ── Server-only secrets (reminder cron) ──
# Service-role key bypasses Row Level Security. Used ONLY by server code
# (the reminder cron). Keep it secret and out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that Vercel Cron sends as the Authorization bearer token when
# invoking /api/cron/push-reminders. Set the same value in the Vercel dashboard.
CRON_SECRET=a-long-random-string

# GitHub PAT/App token scoped to `issues: write` on mp3anthony/funded only.
# Used ONLY by the in-app bug report server route (/api/bug-report) to file a
# GitHub issue on the user's behalf. Never exposed to the client — set as a
# Production-only server env var in Vercel, not committed here.
# GITHUB_BUG_REPORT_TOKEN=your-github-pat-here

# Separate bearer secrets for the Supabase pg_cron jobs (one per route).
GENERATION_CRON_SECRET=another-long-random-string
DELIVER_CRON_SECRET=yet-another-long-random-string
